# QueuePass local dev — placeholders only. Copy to .env and fill in.
# API
DATABASE_URL=postgresql://queuepass_app:CHANGE_ME@localhost:5432/queuepass
MIGRATION_DATABASE_URL=postgresql://queuepass_owner:CHANGE_ME@localhost:5432/queuepass
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
API_PORT=3001
# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# SMS (dev logs to console; no real SMS without credentials)
SMS_PROVIDER=dev
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
GREENWEB_API_TOKEN=
GREENWEB_SENDER_ID=
SMS_SENDER_ID=QUEUEPASS
SMS_COST_NON_MASKING_BDT=0.35
SMS_COST_MASKING_BDT=0.55
